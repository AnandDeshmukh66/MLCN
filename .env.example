# Copy to .env and fill in real values. .env is git-ignored; never commit real keys.

# Google Gemini API key used by the XAI assistant (server-side only).
GEMINI_API_KEY=your-gemini-api-key-here

# Optional settings (defaults shown).
MLCN_LLM_MODEL=gemini-3.5-flash
# Set to true only for Vertex AI express-mode keys.
MLCN_LLM_USE_VERTEXAI=false
MLCN_LLM_TIMEOUT_SECONDS=45
MLCN_LLM_MAX_RETRIES=1
